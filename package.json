{
  "name": "@cesar-html-mx/uxaudit",
  "version": "0.1.0",
  "description": "Local static-analysis CLI for React, JavaScript, and TypeScript projects.",
  "keywords": [
    "accessibility",
    "cli",
    "javascript",
    "performance",
    "react",
    "seo",
    "static-analysis",
    "typescript",
    "ux"
  ],
  "homepage": "https://github.com/cesar-html-mx/UXAudit#readme",
  "bugs": {
    "url": "https://github.com/cesar-html-mx/UXAudit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cesar-html-mx/UXAudit.git"
  },
  "license": "MIT",
  "author": {
    "name": "cesar-html-mx",
    "url": "https://github.com/cesar-html-mx"
  },
  "type": "module",
  "exports": {
    "./schemas/audit-result.schema.json": "./schemas/audit-result.schema.json",
    "./schemas/finding.schema.json": "./schemas/finding.schema.json"
  },
  "bin": {
    "ux-audit": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "schemas",
    "LICENSE",
    "README.md",
    "README.en.md",
    "README.es.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "docs:check": "node scripts/check-bilingual-docs.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "prepack": "npm run build",
    "prepublishOnly": "npm run release:check",
    "release:check": "npm run verify && npm run test:coverage && npm run test:smoke && npm run test:scenario:discovery && npm run test:scenario:parser && npm run test:scenario:rules && npm run test:scenario:reporting && npm run test:scenario:system && npm run test:accuracy && npm run test:robustness && npm run test:usability && npm run test:package && npm audit --audit-level=moderate",
    "setup:hooks": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:accuracy": "npm run build && node scripts/run-accuracy-validation.mjs",
    "test:robustness": "npm run build && node scripts/run-robustness-validation.mjs",
    "test:scenario:discovery": "npm run build && node scripts/run-discovery-scenario.mjs",
    "test:scenario:parser": "npm run build && node scripts/run-parsing-scenario.mjs",
    "test:scenario:reporting": "npm run build && node scripts/run-reporting-scenario.mjs",
    "test:scenario:rules": "npm run build && node scripts/run-rule-engine-scenario.mjs",
    "test:scenario:system": "npm run build && node scripts/run-system-scenario.mjs",
    "test:package": "npm run build && node scripts/check-package.mjs",
    "test:smoke": "npm run build && node scripts/smoke-cli.mjs",
    "test:usability": "npm run build && node scripts/run-usability-review.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "node scripts/check-quality.mjs"
  },
  "dependencies": {
    "@babel/parser": "8.0.4",
    "@babel/traverse": "8.0.4",
    "@babel/types": "8.0.4",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents": false
  }
}
