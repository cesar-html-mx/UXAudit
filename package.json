{
  "name": "ux-audit",
  "version": "0.1.0",
  "description": "Local static-analysis CLI for React and TypeScript projects.",
  "private": true,
  "type": "module",
  "bin": {
    "ux-audit": "dist/cli/index.js"
  },
  "engines": {
    "node": ">=24.18.0 <25",
    "npm": ">=11.16.0 <12"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli/index.ts",
    "docs:check": "node scripts/check-bilingual-docs.mjs",
    "evidence:m01": "node scripts/collect-m01-evidence.mjs",
    "evidence:m02": "node scripts/collect-m02-evidence.mjs",
    "evidence:m02:finalize": "node scripts/finalize-m02-evidence.mjs",
    "evidence:m03": "node scripts/collect-m03-evidence.mjs",
    "evidence:m03:finalize": "node scripts/finalize-m03-evidence.mjs",
    "evidence:m04": "node scripts/collect-m04-evidence.mjs",
    "evidence:m04:finalize": "node scripts/finalize-m04-evidence.mjs",
    "evidence:m05": "node scripts/collect-m05-evidence.mjs",
    "evidence:m05:finalize": "node scripts/finalize-m05-evidence.mjs",
    "evidence:m06": "node scripts/collect-m06-evidence.mjs",
    "evidence:m06:finalize": "node scripts/finalize-m06-evidence.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "prepare": "husky",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:accuracy:m06": "npm run build && node scripts/run-m06-accuracy.mjs",
    "test:robustness:m06": "npm run build && node scripts/run-m06-robustness.mjs",
    "test:usability:m06": "npm run build && node scripts/run-m06-usability.mjs",
    "test:scenario:m02": "npm run build && node scripts/run-m02-scenario.mjs",
    "test:scenario:m03": "npm run build && node scripts/run-m03-scenario.mjs",
    "test:scenario:m04": "npm run build && node scripts/run-m04-scenario.mjs",
    "test:scenario:m05": "npm run build && node scripts/run-m05-scenario.mjs",
    "test:scenario:m06": "npm run build && node scripts/run-m06-scenario.mjs",
    "test:smoke": "npm run build && node scripts/smoke-cli.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "verify": "node .github/harness/scripts/check-quality.mjs"
  },
  "dependencies": {
    "@babel/parser": "8.0.4",
    "@babel/traverse": "8.0.4",
    "@babel/types": "8.0.4",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "globals": "17.7.0",
    "husky": "9.1.7",
    "prettier": "3.9.6",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents": false
  }
}
