{
  "name": "ux-audit",
  "version": "0.1.0",
  "description": "Local static-analysis CLI for React and TypeScript projects.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11.16.0"
  },
  "packageManager": "npm@11.16.0",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "tsx": "4.23.1",
    "typescript": "6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
