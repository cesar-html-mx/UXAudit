flowchart TD

    START((Inicio))
    INPUT[Recibir ruta del proyecto]
    VALIDATE[Validar ruta de entrada]
    VALID_PATH{¿La ruta es válida?}
    ERROR_PATH[Mostrar error de entrada]
    DISCOVERY[Recorrer estructura del proyecto]
    EXCLUSIONS[Aplicar exclusiones]
    INVENTORY[Construir inventario de archivos]
    CANDIDATES{¿Existen archivos candidatos?}
    EMPTY[Informar que no existen archivos analizables]

    SELECT_FILE[Seleccionar siguiente archivo]
    FILE_AVAILABLE{¿Quedan archivos por procesar?}
    CLASSIFY[Clasificar archivo]
    ANALYZABLE{¿El archivo debe analizarse?}
    PARSE[Interpretar código fuente]
    PARSE_OK{¿El parsing fue correcto?}
    PARSE_ERROR[Registrar error de interpretación]
    MODEL[Incorporar información al modelo de análisis]

    LOAD_RULES[Cargar reglas habilitadas]
    SELECT_RULE[Seleccionar siguiente regla]
    RULE_AVAILABLE{¿Quedan reglas por ejecutar?}
    EXECUTE_RULE[Ejecutar regla sobre el modelo]
    FINDINGS{¿La regla generó hallazgos?}
    REGISTER[Registrar hallazgos]

    ORGANIZE[Organizar y clasificar resultados]
    TERMINAL[Generar resumen en terminal]
    JSON[Generar reporte JSON]
    HTML[Generar reporte HTML]
    END((Fin))

    START --> INPUT
    INPUT --> VALIDATE
    VALIDATE --> VALID_PATH

    VALID_PATH -- No --> ERROR_PATH
    ERROR_PATH --> END

    VALID_PATH -- Sí --> DISCOVERY
    DISCOVERY --> EXCLUSIONS
    EXCLUSIONS --> INVENTORY
    INVENTORY --> CANDIDATES

    CANDIDATES -- No --> EMPTY
    EMPTY --> END

    CANDIDATES -- Sí --> FILE_AVAILABLE

    FILE_AVAILABLE -- Sí --> SELECT_FILE
    SELECT_FILE --> CLASSIFY
    CLASSIFY --> ANALYZABLE

    ANALYZABLE -- No --> FILE_AVAILABLE
    ANALYZABLE -- Sí --> PARSE
    PARSE --> PARSE_OK

    PARSE_OK -- No --> PARSE_ERROR
    PARSE_ERROR --> FILE_AVAILABLE

    PARSE_OK -- Sí --> MODEL
    MODEL --> FILE_AVAILABLE

    FILE_AVAILABLE -- No --> LOAD_RULES
    LOAD_RULES --> RULE_AVAILABLE

    RULE_AVAILABLE -- Sí --> SELECT_RULE
    SELECT_RULE --> EXECUTE_RULE
    EXECUTE_RULE --> FINDINGS

    FINDINGS -- Sí --> REGISTER
    REGISTER --> RULE_AVAILABLE

    FINDINGS -- No --> RULE_AVAILABLE

    RULE_AVAILABLE -- No --> ORGANIZE
    ORGANIZE --> TERMINAL
    ORGANIZE --> JSON
    ORGANIZE --> HTML

    TERMINAL --> END
    JSON --> END
    HTML --> END
