{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UXAudit Rule Metadata",
  "type": "object",
  "required": ["id", "title", "category", "severity", "status", "explanation", "recommendation"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+/[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": ["ux", "accessibility", "seo", "performance"]
    },
    "severity": {
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "status": {
      "enum": ["required", "stable", "experimental", "deferred"]
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "recommendation": {
      "type": "string",
      "minLength": 1
    },
    "reference": {
      "type": ["string", "null"]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
