{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UXAudit Rule Metadata",
  "type": "object",
  "required": [
    "id",
    "title",
    "category",
    "defaultSeverity",
    "status",
    "explanation",
    "recommendation",
    "reference",
    "limitations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z]+/[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": ["ux", "accessibility", "seo", "performance"]
    },
    "defaultSeverity": {
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "status": {
      "enum": ["required", "stable", "experimental", "deferred"]
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "recommendation": {
      "type": "string",
      "minLength": 1
    },
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "required": ["label", "url"],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": ["string", "null"],
              "pattern": "^https?://",
              "description": "Nullable absolute HTTP(S) URL without embedded credentials."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
