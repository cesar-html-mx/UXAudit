{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UXAudit AuditResult",
  "type": "object",
  "required": ["schemaVersion", "projectRoot", "summary", "findings", "errors"],
  "properties": {
    "schemaVersion": {
      "type": "string"
    },
    "projectRoot": {
      "type": "string"
    },
    "summary": {
      "type": "object"
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "finding.schema.json"
      }
    },
    "errors": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
