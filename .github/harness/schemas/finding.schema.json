{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UXAudit Finding",
  "type": "object",
  "required": [
    "ruleId",
    "ruleTitle",
    "category",
    "severity",
    "message",
    "explanation",
    "recommendation",
    "limitations",
    "reference",
    "confidence",
    "location"
  ],
  "properties": {
    "ruleId": {
      "type": "string",
      "pattern": "^[a-z]+/[a-z0-9-]+$"
    },
    "ruleTitle": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": ["ux", "accessibility", "seo", "performance"]
    },
    "severity": {
      "enum": ["info", "low", "medium", "high", "critical"]
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "recommendation": {
      "type": "string",
      "minLength": 1
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "required": ["label", "url"],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "url": {
              "type": ["string", "null"],
              "pattern": "^https?://",
              "description": "Nullable absolute HTTP(S) URL without embedded credentials."
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "confidence": {
      "enum": ["high", "medium", "low"]
    },
    "location": {
      "oneOf": [
        {
          "$ref": "#/$defs/sourceLocation"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "sourcePosition": {
      "type": "object",
      "required": ["line", "column", "offset"],
      "properties": {
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "column": {
          "type": "integer",
          "minimum": 0
        },
        "offset": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "sourceLocation": {
      "type": "object",
      "required": ["filePath", "start", "end"],
      "properties": {
        "filePath": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "$ref": "#/$defs/sourcePosition"
        },
        "end": {
          "$ref": "#/$defs/sourcePosition"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
